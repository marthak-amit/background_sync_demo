{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$deviceId": {
        // deviceId == anonymous-auth uid: a device can only read/write its own subtree.
        ".read": "auth != null && auth.uid === $deviceId",
        ".write": "auth != null && auth.uid === $deviceId",
        "logs": {
          "$logId": {
            ".validate": "newData.hasChildren(['value','n','platform','appState','deviceId','clientTime','timestamp','gapSeconds']) && newData.child('deviceId').val() === $deviceId && newData.child('appState').isString() && newData.child('appState').val().matches(/^(foreground|background|killed_relaunch|push_wake|bg_task)$/)"
          }
        }
      }
    }
  }
}
