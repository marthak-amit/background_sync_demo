rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // deviceId == anonymous-auth uid: a device can only read/write its own document and subcollections.
    match /devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == deviceId;

      match /logs/{logId} {
        allow read: if request.auth != null && request.auth.uid == deviceId;
        allow create, update: if request.auth != null && request.auth.uid == deviceId
          && request.resource.data.deviceId == deviceId
          && request.resource.data.appState in ['foreground', 'background', 'killed_relaunch', 'push_wake', 'bg_task'];
        allow delete: if false;
      }

      match /posts/{postId} {
        allow read: if request.auth != null && request.auth.uid == deviceId;
        allow create, update: if request.auth != null && request.auth.uid == deviceId
          && request.resource.data.deviceId == deviceId
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000;
        allow delete: if false;
      }
    }
  }
}
