rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images live at devices/{deviceId}/images/{postId}.jpg; a device can only touch its own folder.
    match /devices/{deviceId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == deviceId;
      allow write: if request.auth != null && request.auth.uid == deviceId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
